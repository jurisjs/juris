{
  "name": "juris",
  "version": "0.93.0",
  "description": "The Juris core: layouts as plain objects, reactive state, the DOM renderer, the router and the browser's live client. No build step, no runtime dependency",
  "keywords": [
    "framework",
    "reactive",
    "server-rendering",
    "live-queries",
    "no-build"
  ],
  "homepage": "https://github.com/jurisjs/juris#readme",
  "license": "Apache-2.0",
  "author": "Resti Guay",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jurisjs/juris.git"
  },
  "bugs": {
    "url": "https://github.com/jurisjs/juris/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "./juris.js",
  "exports": {
    ".": "./juris.js",
    "./*": "./*"
  },
  "files": [
    "*.js",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\""
  }
}
